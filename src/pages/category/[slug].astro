---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { cards, categories } from '../../lib/posts';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug }, props: { name: c.name } }));
}
const { name } = Astro.props;
const list = cards.filter((c) => c.categories.includes(name));
---
<Base title={name}>
  <div class="shell pb-section pt-36">
    <h1 data-lines class="mb-block max-w-5xl text-page">{name}</h1>
    <div class="grid gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-3">{list.map((c) => <PostCard card={c} />)}</div>
  </div>
</Base>
