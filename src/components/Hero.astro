---
// Every page's opening: a full-screen film of real photographs, each pushing in
// slowly and dissolving into the next, with a large white headline over it.
import heroes from '../data/generated/heroes.json';
import type { Action } from '../data/pages';
import Arrow from './Arrow.astro';

type Shot = keyof typeof heroes;
interface Props { title: string; eyebrow?: string; lede?: string; action?: Action; shots: string[]; display?: boolean }
const { title, eyebrow, lede, action, shots, display } = Astro.props;
const film = shots.map((n) => {
  const s = heroes[n as Shot];
  if (!s) throw new Error(`No hero photo named "${n}"`);
  return s;
});
const srcset = (s: (typeof film)[number]) => `${s.sm} 1280w, ${s.lg} ${s.w}w`;
---
<section data-hero class="theme-dark relative flex min-h-svh items-end overflow-hidden bg-ink">
  <div data-film class="film" aria-hidden="true">
    {film.map((s, i) => i === 0
      ? <img class="film-shot" data-first src={s.lg} srcset={srcset(s)} sizes="100vw" width={s.w} height={s.h} alt="" fetchpriority="high" decoding="async" />
      : <img class="film-shot" data-srcset={srcset(s)} data-src={s.lg} sizes="100vw" width={s.w} height={s.h} alt="" decoding="async" />)}
  </div>
  <div data-hero-copy class="shell relative pb-8 pt-36 md:pb-block">
    {eyebrow && <p class="label mb-5" data-reveal>{eyebrow}</p>}
    <h1 data-lines class:list={['max-w-7xl', display ? 'text-display' : 'text-page']}>{title}</h1>
    {lede && <p data-reveal class="mt-7 max-w-2xl text-lead">{lede}</p>}
    {action && <a data-reveal href={action.href} class="btn mt-8">{action.label}<Arrow /></a>}
    <slot />
  </div>
  {film.length > 1 && (
    <div data-film-bars aria-hidden="true" class="film-bars">
      {film.map(() => <span><i></i></span>)}
    </div>
  )}
</section>
