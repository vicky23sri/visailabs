---
import { ui } from '../data/site';
import type { Media } from '../lib/media';
interface Props { id: string; title?: string; poster?: Media; grow?: boolean }
const { id, title, poster, grow } = Astro.props;
---
<div data-rise={grow ? undefined : ''} data-grow={grow ? '' : undefined} class="photo zoom video-frame aspect-video w-full">
  <button data-video={id} aria-label={title ? `${ui.play}: ${title}` : ui.play} class="video-btn absolute inset-0 size-full cursor-pointer">
    {poster
      ? <img src={poster.src} alt="" loading="lazy" class="size-full object-cover" />
      : <img src={`https://i.ytimg.com/vi/${id}/maxresdefault.jpg`} onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'`} alt="" loading="lazy" class="size-full object-cover" />}
    {poster && <span class="scrim absolute inset-0"></span>}
    <span data-play class="play">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 0 0 1.2.7l11-6.8a.8.8 0 0 0 0-1.4l-11-6.8a.8.8 0 0 0-1.2.7Z" /></svg>
    </span>
  </button>
</div>
