---
import { newTab } from '../lib/links';
import { footer, social, legal, site } from '../data/site';
---
<footer class="theme-dark relative overflow-hidden bg-ink">
  <canvas data-contour aria-hidden="true" class="absolute inset-0 size-full opacity-0 transition-opacity duration-1000"></canvas>
  <div class="shell relative pt-section">
    <div class="grid gap-12 lg:grid-cols-12">
      <p data-reveal class="serif text-statement lg:col-span-7">{site.tagline}</p>
      <div class="grid grid-cols-2 gap-10 lg:col-span-4 lg:col-start-9">
        {footer.map((col) => (
          <div>
            <p class="label text-muted">{col.title}</p>
            <ul class="mt-4 space-y-2">
              {col.links.map((l) => <li><a href={l.href} {...newTab(l.href)} class="text-small transition-opacity hover:opacity-60">{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-section flex flex-wrap items-center justify-between gap-6 border-t border-line py-5">
      <p class="label">{site.rights}</p>
      <ul class="label flex flex-wrap gap-6">
        {[...social, ...legal].map((l) => <li><a href={l.href} {...newTab(l.href)} class="transition-opacity hover:opacity-60">{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <p aria-hidden="true" class="serif relative select-none whitespace-nowrap pb-4 text-center text-mega">{site.name}</p>
</footer>
