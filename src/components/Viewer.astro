---
import { ui } from '../data/site';
const icon = (d: string) => `<svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="${d}" /></svg>`;
---
<dialog data-viewer class="viewer">
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 p-4 md:px-6">
      <p class="min-w-0 truncate"><span data-viewer-title class="serif text-title"></span> <span data-viewer-count class="label ml-3 opacity-70"></span></p>
      <button type="button" data-viewer-close aria-label={ui.close} class="viewer-btn shrink-0" set:html={icon('M3 3l10 10M13 3 3 13')} />
    </div>
    <div data-viewer-stage class="relative min-h-0 flex-1 touch-pan-y overflow-hidden">
      <img data-viewer-img alt="" class="absolute inset-0 size-full object-contain" />
      <button type="button" data-viewer-prev aria-label={ui.previous} class="viewer-btn absolute left-3 top-1/2 z-1 -translate-y-1/2 md:left-6" set:html={icon('M10 3 5 8l5 5')} />
      <button type="button" data-viewer-next aria-label={ui.next} class="viewer-btn absolute right-3 top-1/2 z-1 -translate-y-1/2 md:right-6" set:html={icon('M6 3l5 5-5 5')} />
    </div>
    <div data-viewer-thumbs class="flex gap-2 overflow-x-auto p-4 md:justify-center-safe md:px-6"></div>
  </div>
</dialog>
